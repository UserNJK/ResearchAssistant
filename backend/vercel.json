{
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
  "outputDirectory": ".",
  "framework": "python",
  "functions": {
    "app/main.py": {
      "runtime": "python3.11",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py",
      "methods": ["GET", "POST", "OPTIONS", "DELETE", "PUT", "PATCH"]
    }
  ]
}
