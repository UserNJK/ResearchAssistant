# Backend environment variables
# Fill these values before running locally or deploying.

ENVIRONMENT=development
OPENROUTER_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local + deployed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://researchbot-psi.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400
