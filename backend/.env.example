# ResearchAssistant Backend - Environment Configuration
# Copy this file to .env and fill in actual values
# DO NOT commit .env file to git

# ═══════════════════════════════════════════════════════════════════
# SUPABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ═══════════════════════════════════════════════════════════════════
# OPENROUTER CONFIGURATION (for LLM)
# ═══════════════════════════════════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-...

# ═══════════════════════════════════════════════════════════════════
# JWT CONFIGURATION (PHASE 6)
# ═══════════════════════════════════════════════════════════════════
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400

# ═══════════════════════════════════════════════════════════════════
# RATE LIMITING CONFIGURATION (PHASE 6)
# ═══════════════════════════════════════════════════════════════════
USER_RATE_LIMIT_REQUESTS=100
USER_RATE_LIMIT_WINDOW_SECONDS=3600

# ═══════════════════════════════════════════════════════════════════
# CORS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ═══════════════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
ENVIRONMENT=production
DEBUG=false

# ═══════════════════════════════════════════════════════════════════
# INSTRUCTIONS FOR VERCEL DEPLOYMENT
# ═══════════════════════════════════════════════════════════════════
# 1. Create a Supabase project at https://supabase.com
# 2. Get SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from Supabase dashboard
# 3. Get OPENROUTER_API_KEY from https://openrouter.ai
# 4. In Vercel Project Settings → Environment Variables:
#    - Add all variables with their actual values
#    - Select "Production" environment
# 5. Re-deploy after adding environment variables
